# Vercel 프로젝트 환경변수로 등록할 값들 (Vercel 대시보드 → Settings → Environment Variables)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=
DASHBOARD_URL=
# Vercel Cron이 daily-brief를 호출할 때 자동으로 Authorization 헤더에 실어보내는 값. 아무 임의 문자열이나 생성해서 등록.
CRON_SECRET=
# api.slack.com/apps에서 Interactivity & Shortcuts를 켜고 발급받는 값들 (자산 변동 Slack 모달 입력용)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
